rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == "pukNRH3o6JZBM4ScaIontWbRnJg1";
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    match /inquiries/{inquiryId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.boardType == "inquiry"
        && request.resource.data.author.id == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.author.id == request.auth.uid
          && request.resource.data.author.id == request.auth.uid
          && request.resource.data.answer == resource.data.answer);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.author.id == request.auth.uid);
    }
  }
}
